#!/bin/sh
# Refuses commits that contain competition data or large files.
# Enable once per clone:  git config core.hooksPath .githooks
status=0
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
  case "$f" in
    *.mp4|*_atd.txt|*_atd.xml|*_homography.csv|*_smart_tagging.xml|*.npz|*.npy|*.parquet|data/*|cache/*|submissions/*)
      echo "pre-commit: refusing to commit data file: $f"; status=1 ;;
  esac
  if [ -f "$f" ]; then
    size=$(wc -c < "$f" | tr -d ' ')
    if [ "$size" -gt 1000000 ]; then
      echo "pre-commit: refusing to commit a file larger than 1 MB: $f"; status=1
    fi
  fi
done
exit $status
